# Copy to .env, fill locally, then load explicitly: set -a; source .env; set +a
# .env is ignored by Git. The agent reads environment variables, not this file.
SHOPPING_COPILOT_MODE=react
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
SHOPPING_COPILOT_MAX_STEPS=8
SHOPPING_COPILOT_LLM_TIMEOUT=30
SHOPPING_COPILOT_LLM_MAX_TOKENS=1600
SHOPPING_COPILOT_LLM_FALLBACK=true
